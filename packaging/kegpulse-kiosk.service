[Unit]
Description=KegPulse Chromium kiosk
After=graphical-session.target kegpulse.service
Wants=kegpulse.service

[Service]
Type=simple
ExecStart=@PYTHON@ @WAIT_HELPER@ --health-url @HEALTH_URL@ --page-url @PAGE_URL@ --browser chromium
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
