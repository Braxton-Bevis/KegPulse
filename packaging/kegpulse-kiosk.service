[Unit]
Description=KegPulse Chromium kiosk
After=graphical-session.target kegpulse.service
Wants=kegpulse.service

[Service]
Type=simple
ExecStart=/bin/sh -c 'until curl -fsS http://127.0.0.1:8765/api/v1/health >/dev/null; do sleep 1; done; exec chromium --kiosk --no-first-run --disable-session-crashed-bubble http://127.0.0.1:8765/'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target

